// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Extension",
			"type": "npm",
			"path": "extension/",
			"script": "build",
			"group": "build",
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish"
			],
			"detail": "Build extension only",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": true
			}
		},
		{
			"label": "Lint Extension",
			"type": "npm",
			"script": "lint",
			"path": "extension/",
			"problemMatcher": [
				"$tsc",
				"$eslint-compact"
			]
		},
		{
			"label": "Generate Protobuf Bindings",
			"type": "npm",
			"script": "gen",
			"path": "extension/",
			"problemMatcher": []
		},
		{
			"label": "Build Debug Server",
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"args": [ "--manifest-path=${workspaceFolder}/server/Cargo.toml" ]
		},
		{
			"label": "Build Release Server",
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"args": [
				"-r",
				"--manifest-path=${workspaceFolder}/server/Cargo.toml"
			],
			"group": "build"
		},
		{
			"label": "Build Debug",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Build server & extension & lint",
			"dependsOn": [
				"Build Debug Server",
				"Build Extension",
				"Lint Extension"
			]
		},
	]
}